// For format details, see https://aka.ms/devcontainer.json.
{
  "name": "Kinoite Image Development",
  "image": "mcr.microsoft.com/devcontainers/base:trixie",

  "features": {
    "ghcr.io/devcontainers-extra/features/apt-packages:1": {
      "packages": "just,jq,shellcheck,shfmt,podman"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": ["redhat.vscode-yaml", "esbenp.prettier-vscode"]
    }
  },

  "mounts": [
    "source=/run/user/1000/podman/podman.sock,target=/run/podman/podman.sock,type=bind"
  ],

  "containerEnv": {
    "CONTAINER_HOST": "unix:///run/podman/podman.sock"
  }
}
