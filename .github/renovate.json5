{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:best-practices"],

  rebaseWhen: "never",

  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/Containerfile/"],
      matchStrings: ["ARG FEDORA_MAJOR_VERSION=(?<currentValue>\\d+)"],
      depNameTemplate: "ghcr.io/ublue-os/kinoite-main",
      datasourceTemplate: "docker",
      versioningTemplate: "loose",
    },
  ],

  packageRules: [
    {
      matchManagers: ["custom.regex"],
      matchPackageNames: ["ghcr.io/ublue-os/kinoite-main"],
      allowedVersions: "/^\\d+$/",
      groupName: "Fedora major version",
      automerge: false,
    },
    {
      enabled: false,
      matchManagers: ["custom.regex"],
      matchPackageNames: ["ghcr.io/ublue-os/kinoite-main"],
      matchUpdateTypes: ["pinDigest"],
    },
    {
      automerge: true,
      matchUpdateTypes: ["pin", "pinDigest"],
    },
    {
      enabled: false,
      matchUpdateTypes: ["digest", "pinDigest", "pin"],
      matchDepTypes: ["container"],
      matchFileNames: [".github/workflows/**.yaml", ".github/workflows/**.yml"],
    },
  ],
}
